{
  "name": "healthgrid-backend",
  "version": "1.0.0",
  "description": "HealthGrid REST API (Node.js, Express, MongoDB/Mongoose)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "web": "npm run dev",
    "build": "npm --prefix client run build",
    "seed": "node src/seed/seed.js",
    "test": "node tests/test-medical-pipeline.js",
    "test:api": "node tests/test-all.js",
    "test:all": "node tests/test-medical-pipeline.js && node tests/test-all.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.4"
  }
}
