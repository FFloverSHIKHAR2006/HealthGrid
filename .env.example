# ==============================================================================
# HealthGrid Environment Configuration Template
# NOTE: Do NOT commit your real production secrets to version control!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection Configuration
# For Local MongoDB (Compass default): mongodb://127.0.0.1:27017/healthgrid
# For MongoDB Atlas: mongodb+srv://<db_user>:<db_password>@<cluster-url>.mongodb.net/healthgrid?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/healthgrid
MONGODB_DB_NAME=healthgrid
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_TIMEOUT_MS=10000

# Authentication & JWT Security
JWT_SECRET=replace_with_a_secure_cryptographic_64_character_random_secret_key
JWT_EXPIRES_IN=8h

# Seed Demo Passwords (only used when running npm run seed)
SEED_PASSWORD=Password@123

# Quick Sign-In / OAuth Providers (Optional - Leave blank to see transparent setup prompt)
# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft Azure AD / Entra ID Credentials (from Azure Portal -> App Registrations)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common
